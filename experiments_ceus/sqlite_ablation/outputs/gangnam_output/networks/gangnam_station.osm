  <node id="12468525401" version="3" timestamp="2025-01-02T09:48:51Z" lat="37.4999066" lon="127.0277638">
    <tag k="alt_name" v="Jushindang Gangnam Cocktail Bar;Zoo Sindang"/>
    <tag k="amenity" v="bar"/>
    <tag k="contact:instagram" v="zoosindang_gangnam"/>
    <tag k="contact:naver" v="https://map.naver.com/p/entry/place/1916994932"/>
    <tag k="contact:tripadvisor" v="https://tripadvisor.com/Restaurant_Review-g294197-d27939231-Reviews-Zoosindang-Seoul.html"/>
    <tag k="description" v="주신당은 서울 신당동에 위치한 동양식 다이닝 바 및 레스토랑으로, 외관은 임시 시장 가판대를 연상시킵니다. 내부는 신비로운 별자리 숲으로 디자인되어 있으며, 매달린 식물과 아시아 별자리의 12동물을 참조하는 요소들이 있습니다."/>
    <tag k="description:en" v="ZooSinDang is an oriental dining bar and restaurant in the Sindang-dong district of Seoul, featuring an exterior that resembles an improvised market stall. The interior is designed as a mysterious forest of zodiac signs, with hanging plants"/>
    <tag k="description:ko" v="주신당은 서울 신당동에 위치한 동양식 다이닝 바 및 레스토랑으로, 외관은 임시 시장 가판대를 연상시킵니다. 내부는 신비로운 별자리 숲으로 디자인되어 있으며, 매달린 식물과 아시아 별자리의 12동물을 참조하는 요소들이 있습니다."/>
    <tag k="language:en" v="yes"/>
    <tag k="language:ko" v="yes"/>
    <tag k="name" v="ZooSinDang Gangnam Cocktail Bar"/>
