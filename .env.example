# AgentSUMO environment configuration
# Copy this file to `.env` and fill in your own credentials:
#   cp .env.example .env

# === Required ===

# Anthropic Claude API key.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Mapbox access token (used by the web interface for basemap rendering).
# Get one at: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Absolute path to your local SUMO installation.
# On macOS (official SUMO installer):
#   /Library/Frameworks/EclipseSUMO.framework/Versions/<version>/EclipseSUMO
# On Linux (apt install sumo):
#   /usr/share/sumo
SUMO_HOME=

# === Optional ===

# Override the base directory for AgentSUMO MCP server outputs (networks,
# trips, simulations, etc.). Defaults to the current working directory.
# AGENTSUMO_MCP_OUTPUT_BASE=
